{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "rulewatch",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "redis": true,
    "http": {
      "enable": true,
      "domains": []
    }
  },
  "menu": {
    "items": [
      {
        "label": "Open RuleWatch",
        "description": "Open RuleWatch for this post",
        "location": ["post"],
        "forUserType": "moderator",
        "postFilter": "none",
        "endpoint": "/internal/menu/open-rulewatch"
      },
      {
        "label": "Create a new post",
        "description": "rulewatch",
        "location": ["subreddit"],
        "forUserType": "moderator",
        "postFilter": "none",
        "endpoint": "/internal/menu/post-create"
      },
      {
        "label": "Example form",
        "description": "Show a simple form",
        "location": ["subreddit"],
        "forUserType": "moderator",
        "postFilter": "none",
        "endpoint": "/internal/menu/example-form"
      }
    ]
  },
  "forms": {
    "exampleForm": "/internal/form/example-submit"
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install",
    "onPostCreate": "/internal/triggers/on-post-create"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "dev": {
    "subreddit": "rulewatch_dev"
  }
}